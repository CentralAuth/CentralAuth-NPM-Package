{
  "name": "centralauth",
  "version": "1.0.7",
  "description": "Official package for CentralAuth",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client.d.ts",
      "import": "./src/client.js",
      "require": "./dist/cjs/src/client.js",
      "default": "./src/client.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "import": "./src/server.js",
      "require": "./dist/cjs/src/server.js",
      "default": "./src/server.js"
    },
    "./native": {
      "types": "./src/native.d.ts",
      "import": "./src/native.js",
      "require": "./dist/cjs/src/native.js",
      "default": "./src/native.js"
    },
    "./types": {
      "types": "./src/types.d.ts",
      "import": "./src/types.js",
      "require": "./dist/cjs/src/types.js",
      "default": "./src/types.js"
    },
    "./types.server": {
      "types": "./src/types.server.d.ts",
      "import": "./src/types.server.js",
      "require": "./dist/cjs/src/types.server.js",
      "default": "./src/types.server.js"
    },
    "./react.types": {
      "types": "./src/react.types.d.ts",
      "import": "./src/react.types.js",
      "require": "./dist/cjs/src/react.types.js",
      "default": "./src/react.types.js"
    },
    "./openapi-ts.config": {
      "types": "./openapi-ts.config.d.ts",
      "import": "./openapi-ts.config.js",
      "require": "./dist/cjs/openapi-ts.config.js",
      "default": "./openapi-ts.config.js"
    },
    "./api": {
      "types": "./api/index.d.ts",
      "import": "./api/index.js",
      "require": "./api/index.js",
      "default": "./api/index.js"
    },
    "./api/client": {
      "types": "./api/client.gen.d.ts",
      "import": "./api/client.gen.js",
      "require": "./api/client.gen.js",
      "default": "./api/client.gen.js"
    },
    "./api/sdk": {
      "types": "./api/sdk.gen.d.ts",
      "import": "./api/sdk.gen.js",
      "require": "./api/sdk.gen.js",
      "default": "./api/sdk.gen.js"
    },
    "./api/types": {
      "types": "./api/types.gen.d.ts",
      "import": "./api/types.gen.js",
      "require": "./api/types.gen.js",
      "default": "./api/types.gen.js"
    }
  },
  "scripts": {
    "build": "rm -f tsconfig.tsbuildinfo && rm -rf dist/cjs && openapi-ts && npx tsc && node scripts/add-type-references.cjs && npm run build:cjs",
    "build:cjs": "mkdir -p dist/cjs && printf '{\"type\":\"commonjs\"}\n' > dist/cjs/package.json && npx tsc -p tsconfig.cjs.json && node scripts/add-type-references.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CentralAuth/CentralAuth-NPM-Package"
  },
  "homepage": "https://github.com/CentralAuth/CentralAuth-NPM-Package",
  "keywords": [
    "Authentication",
    "CentralAuth",
    "OAuth",
    "JWT"
  ],
  "author": "West IT",
  "license": "MIT",
  "dependencies": {
    "@craftzdog/react-native-buffer": "^6.1.2",
    "@hey-api/openapi-ts": "^0.99.0",
    "axios": "^1.19.0",
    "axios-cache-interceptor": "^1.12.3",
    "jose": "^6.2.8",
    "react-native-quick-base64": "^3.0.1"
  },
  "peerDependencies": {
    "expo-crypto": "^57.0.0",
    "expo-device": "^57.0.0",
    "expo-linking": "^57.0.0",
    "expo-secure-store": "^57.0.0",
    "expo-web-browser": "^57.0.0",
    "react": "^19.2.7"
  },
  "peerDependenciesMeta": {
    "expo-crypto": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    },
    "expo-linking": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "expo-crypto": "^57.0.0",
    "expo-device": "^57.0.0",
    "expo-linking": "^57.0.0",
    "expo-secure-store": "^57.0.0",
    "expo-web-browser": "^57.0.0",
    "typescript": "^6.0.3"
  }
}